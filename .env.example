# Set these in the environment (or a container env file). All are optional.

# CIVITAI_API_KEY=            # sent upstream as "Authorization: Bearer <key>"
# DEFAULT_SOURCE=civitai.com  # civitai.com or civitai.red
# HTTPS_PROXY=                # standard proxy variable, honoured for upstream calls
# CACHE_TTL=300
# UPSTREAM_CONCURRENCY=8
# HOST=0.0.0.0
# PORT=8000
